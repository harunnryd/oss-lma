{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oss-lma",
  "version": "0.1.0",
  "identifier": "com.osslma.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../src run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../src run build",
    "frontendDist": "../src/dist",
    "beforeBundleCommand": "uv run --with pyinstaller python ../scripts/build_sidecar.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "oss-lma",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../target/sidecar/sidecar": "sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
