{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oss-lma",
  "version": "0.1.0",
  "identifier": "com.osslma.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "oss-lma",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../python/sidecar": "python/sidecar",
      "../python/lma_stt": "python/lma_stt",
      "../python/lma_pipeline": "python/lma_pipeline",
      "../contracts": "contracts"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
