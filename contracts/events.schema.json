{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oss-lma sidecar wire protocol",
  "notes": [
    "Wire convention: PascalCase keys on ALL frames, both directions.",
    "Text frames are JSON events; binary frames are interleaved stereo s16le PCM.",
    "Timestamps on the wire are float seconds from stream start; SQLite stores integer milliseconds."
  ],
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Channel": { "enum": ["CALLER", "AGENT", "AGENT_ASSISTANT"] },
    "Envelope": {
      "type": "object",
      "required": ["EventType"],
      "properties": {
        "EventType": { "type": "string" },
        "CallId": { "$ref": "#/$defs/Uuid" },
        "CreatedAt": { "type": "string", "format": "date-time" },
        "UpdatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Start": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "START" },
        "SamplingRate": { "type": "integer", "minimum": 8000 },
        "DiarizeSystemChannel": { "type": "boolean", "default": false },
        "DiarizeMicChannel": { "type": "boolean", "default": false }
      },
      "required": ["EventType", "CallId", "SamplingRate"]
    },
    "SpeakerChange": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "SPEAKER_CHANGE" },
        "Channel": { "enum": ["CALLER", "AGENT"] },
        "ActiveSpeaker": { "type": "string" }
      },
      "required": ["EventType", "CallId", "Channel", "ActiveSpeaker"]
    },
    "Pause": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": { "EventType": { "const": "PAUSE" } },
      "required": ["EventType", "CallId"]
    },
    "Resume": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": { "EventType": { "const": "RESUME" } },
      "required": ["EventType", "CallId"]
    },
    "End": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "END" }
      },
      "required": ["EventType", "CallId"]
    },
    "VpCommand": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "VP_COMMAND" },
        "TaskId": { "type": "string" },
        "Command": {
          "enum": ["CLICK", "TYPE", "CHAT", "RESET_SELECTORS", "END", "PAUSE", "RESUME"],
          "type": "string"
        },
        "Payload": { "type": "object" }
      },
      "required": ["EventType", "TaskId", "Command"]
    },
    "AddTranscriptSegment": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "ADD_TRANSCRIPT_SEGMENT" },
        "SegmentId": { "type": "string" },
        "Channel": { "$ref": "#/$defs/Channel" },
        "Speaker": { "type": "string" },
        "StartTime": { "type": "number", "description": "seconds from stream start" },
        "EndTime": { "type": "number" },
        "Transcript": { "type": "string" },
        "IsPartial": { "type": "boolean" },
        "SentimentScore": { "type": ["number", "null"] }
      },
      "required": ["EventType", "CallId", "SegmentId", "Channel", "StartTime", "EndTime", "Transcript", "IsPartial"]
    },
    "AddSummary": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "ADD_SUMMARY" },
        "Section": { "type": "string" },
        "SummaryText": { "type": "string" }
      },
      "required": ["EventType", "CallId", "Section", "SummaryText"]
    },
    "AddAgentAssist": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "ADD_AGENT_ASSIST" },
        "SegmentId": { "type": "string" },
        "TriggerSegmentId": { "type": "string" },
        "Transcript": { "type": "string" },
        "IsPartial": { "type": "boolean" }
      },
      "required": ["EventType", "CallId", "SegmentId", "Transcript", "IsPartial"]
    },
    "AgentToken": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "AGENT_TOKEN" },
        "Seq": { "type": "integer", "minimum": 0 },
        "Delta": { "type": "string" }
      },
      "required": ["EventType", "CallId", "Seq", "Delta"]
    },
    "ThinkingStep": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "THINKING_STEP" },
        "Seq": { "type": "integer" },
        "StepType": { "enum": ["reasoning", "tool_use", "tool_result", "status"] },
        "Content": { "type": "string" },
        "ToolName": { "type": ["string", "null"] },
        "ToolInput": { "type": ["object", "null"] },
        "ToolResult": { "type": ["object", "null"] },
        "Success": { "type": ["boolean", "null"] }
      },
      "required": ["EventType", "CallId", "Seq", "StepType"]
    },
    "VpStatus": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "VP_STATUS" },
        "TaskId": { "type": "string" },
        "State": {
          "enum": ["PENDING", "LAUNCHING", "JOINING", "IN_MEETING",
                   "AWAITING_ACTION", "FINALIZING", "DONE", "FAILED"]
        },
        "Detail": { "type": "string" }
      },
      "required": ["EventType", "TaskId", "State"]
    },
    "VpScreenshot": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "VP_SCREENSHOT" },
        "TaskId": { "type": "string" },
        "ImageBase64": { "type": "string", "contentEncoding": "base64" }
      },
      "required": ["EventType", "TaskId", "ImageBase64"]
    },
    "Error": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "EventType": { "const": "ERROR" },
        "Code": { "$ref": "errors.yaml" },
        "Context": { "type": "object" }
      },
      "required": ["EventType", "CallId", "Code"]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/Start" },
    { "$ref": "#/$defs/SpeakerChange" },
    { "$ref": "#/$defs/Pause" },
    { "$ref": "#/$defs/Resume" },
    { "$ref": "#/$defs/End" },
    { "$ref": "#/$defs/VpCommand" },
    { "$ref": "#/$defs/AddTranscriptSegment" },
    { "$ref": "#/$defs/AddSummary" },
    { "$ref": "#/$defs/AddAgentAssist" },
    { "$ref": "#/$defs/AgentToken" },
    { "$ref": "#/$defs/ThinkingStep" },
    { "$ref": "#/$defs/VpStatus" },
    { "$ref": "#/$defs/VpScreenshot" },
    { "$ref": "#/$defs/Error" }
  ]
}
